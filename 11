        надпись_топлива.setVisible(false);
    }


    //значения видимости для проигрыша

    static void gameOver() {

        игра_окончена = true;

        таймер_игры.stop();
        таймер_корабля.stop();

        надпись_заряда.setVisible(false);
        надпись_корабля.setVisible(false);
        надпись_топлива.setVisible(false);

        кнопка_генераторной.setVisible(false);
        кнопка_двери.setVisible(false);
        кнопка_фонаря.setVisible(false);
        кнопка_склада.setVisible(false);
        кнопка_карты.setVisible(false);
        кнопка_назад.setVisible(false);

        кнопка_заправки.setVisible(false);
        кнопка_запуска_генератора.setVisible(false);
