    //-

    static ImageIcon sbg(String путь_к_изображению) {

        try {


            Image исходное_изображение = ImageIO.read(new File(путь_к_изображению));


            if (исходное_изображение == null) {
                System.out.println("Не удалось прочитать изображение: " + путь_к_изображению);
                return null;
            }

            //вгоняем в размер окна
            Image масштабированное_изображение = исходное_изображение.getScaledInstance(1000, 600, Image.SCALE_SMOOTH);


            return new ImageIcon(масштабированное_изображение);

        } catch (IOException ошибка_чтения) {


            return null;
        }
    }


    //в целом создание кнопок

    static JButton mkText(String текст_кнопки, int координата_х, int координата_у, int ширина, int высота) {

        //вызываем
        JButton созданная_кнопка = new JButton(текст_кнопки);

        //шрифт
        созданная_кнопка.setFont(new Font("Arial", Font.BOLD, 20));

        созданная_кнопка.setBounds(координата_х, координата_у, ширина, высота);//сткавим коорды

        //косметические поправки
        созданная_кнопка.setBackground(new Color(35, 35, 35));
        созданная_кнопка.setForeground(Color.WHITE);
        созданная_кнопка.setFocusPainted(false);
        созданная_кнопка.setBorderPainted(true);
        созданная_кнопка.setOpaque(true);

        return созданная_кнопка;
    }
