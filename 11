            static String КАРТИНКА_ФОНАРЬ_ВЫКЛ = "C:\\Users\\maxdm\\Downloads\\Диптих_ маяк в огне и тьме (3).png";
            static String КАРТИНКА_КАРТА = "C:\\Users\\maxdm\\Downloads\\lmDVXctMjrTtISGRl0qqaAqjDVtyYcdpAotuOOzaK7Cikt_S-PDWkwFZ3O6L2DrH7ndvzqY38SatoPT0yyHlVaHNQTLW2g (1).png";
