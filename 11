    //опять корабль
    static void shipArrives() {

        корабль_ожидает_сопровождения = true;

        надпись_корабля.setText("ПРИБЫЛ КОРАБЛЬ! Сопроводите его немедленно!");

        if (текущая_комната.equals("map")) {
            updateEscortButton();
        }

        таймер_корабля.restart();//через 10 секунд игра окончена если не сопроводить

        панель_игры.repaint();
    }


    static void updateEscortButton() {

        boolean показывать_кнопку = текущая_комната.equals("map") && корабль_ожидает_сопровождения;

        кнопка_сопровождения.setVisible(показывать_кнопку);

        if (показывать_кнопку) {

            //должен быть свет
            if (маяк_вкл_выкл) {
                кнопка_сопровождения.setEnabled(true);
                кнопка_сопровождения.setText("Сопроводить корабль");
            }

            else {
                кнопка_сопровождения.setEnabled(false);
                кнопка_сопровождения.setText("Сначала включите свет!");
            }
        }

        панель_игры.repaint();
    }


    //фонарь выключаем

    static void turnOffLight() {

        маяк_вкл_выкл = false;

        if (текущая_комната.equals("lantern")) {
            изображение_комнаты.setIcon(sbg(путь_фона_фонаря_выключен));

            кнопка_включения_фонаря.setVisible(генератор_включён);
        }

        if (текущая_комната.equals("map")) {
            updateEscortButton();
        }

        панель_игры.repaint();
    }


    //стартовая часть и если перезапуск

    static void startGame() {

        таймер_игры.stop();
        таймер_корабля.stop();

        заряд_батареи = 100;

        топливо_генератора = 0;
        генератор_заправлен = false;
        генератор_включён = false;
        маяк_вкл_выкл = false;
        игра_окончена = false;
        корабль_ожидает_сопровождения = false;
        надпись_заряда.setText("Заряд: 100%");
        надпись_корабля.setText("");
        надпись_топлива.setText("Топливо генератора: 0%");
        надпись_заряда.setVisible(true);
        надпись_корабля.setVisible(true);
        кнопка_новой_игры.setVisible(false);
        кнопка_настроек.setVisible(false);
        showLighthouse();
        таймер_игры.start();
        панель_игры.repaint();
    }


