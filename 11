    //дополнение к генератору

    static void openGenerator() {

        текущая_комната = "generator";

        изображение_комнаты.setIcon(sbg(путь_фона_генераторной));//загрузили изображение
        изображение_комнаты.setText("");

        hideRooms();

        кнопка_назад.setVisible(true);

        надпись_топлива.setText("Топливо генератора: " + топливо_генератора + "%");
        надпись_топлива.setVisible(true);

        кнопка_заправки.setVisible(!генератор_заправлен);

        кнопка_запуска_генератора.setVisible(генератор_заправлен && !генератор_включён);

        панель_игры.repaint();
    }


    //комната с фонарем

    static void openLantern() {

        текущая_комната = "lantern";

        hideRooms();

        //темная или светлая комната
        if (маяк_вкл_выкл) {
            изображение_комнаты.setIcon(sbg(путь_фона_фонаря_включён));
        }

        else {
            изображение_комнаты.setIcon(sbg(путь_фона_фонаря_выключен));
        }

        изображение_комнаты.setText("");

        кнопка_назад.setVisible(true);//кнопка возврата

        кнопка_включения_фонаря.setVisible(генератор_включён && !маяк_вкл_выкл);

        панель_игры.repaint();
    }


    //стол картографа

    static void openMap() {

