            //шансы событий (проверяются при каждом тике главного таймера)
            static double ШАНС_ОСТАНОВКИ_ГЕНЕРАТОРА = 0.05;
            static double ШАНС_ОТКЛЮЧЕНИЯ_СВЕТА = 0.03;
            static double ШАНС_ПРИБЫТИЯ_КОРАБЛЯ = 0.02;

            //переменные состояния игры
            static int заряд = 100;
            static int топливо = 0;
            static boolean генераторРаботает = false;
            static boolean светВключён = false;
            static boolean играОкончена = false;
            static boolean корабльЖдёт = false;
            static String текущаяКомната = "меню";

            //элементы интерфейса
            static JFrame окно;
            static JPanel панель;
            static JLabel фон;

            static JLabel надписьЗаряд;
            static JLabel надписьФонарь;
            static JLabel надписьТопливо;
            static JLabel надписьКорабль;

            static JButton кнопкаНоваяИгра;
            static JButton кнопкаНастройки;

            static JButton кнопкаГенераторная;
            static JButton кнопкаДверь;
            static JButton кнопкаФонарь;
            static JButton кнопкаСклад;
            static JButton кнопкаКарта;
            static JButton кнопкаНазад;

            static JButton кнопкаЗаправить;
            static JButton кнопкаЗапустить;
            static JButton кнопкаВосстановить;
            static JButton кнопкаСопроводить;

            static Timer главныйТаймер;
            static Timer таймерКорабля;

            //главный метод
            public static void main(String[] args) {
                createWindow();
                createLabels();
                createButtons();
                createTimers();
                addListeners();
                menu();
                окно.add(панель);
                окно.setVisible(true);
            }

            //окно,панель и фон
            static void createWindow() {
                окно = new JFrame("Маяк 17");
                окно.setSize(1000, 600);
                окно.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
                окно.setLocationRelativeTo(null);
                окно.setResizable(false);

                панель = new JPanel();
                панель.setLayout(null);

                фон = new JLabel();
                фон.setBounds(0, 0, 1000, 600);
                панель.add(фон);
            }

            //надписи
            static void createLabels() {
                надписьЗаряд = new JLabel("Заряд: 100%");
                надписьЗаряд.setFont(new Font("Arial", Font.BOLD, 22));
                надписьЗаряд.setForeground(Color.WHITE);
                надписьЗаряд.setBounds(20, 15, 250, 35);
                панель.add(надписьЗаряд);

                надписьФонарь = new JLabel("Фонарь: выключен");
                надписьФонарь.setFont(new Font("Arial", Font.BOLD, 20));
                надписьФонарь.setForeground(Color.WHITE);
                надписьФонарь.setBounds(20, 50, 600, 35);
                панель.add(надписьФонарь);

                надписьКорабль = new JLabel("");
                надписьКорабль.setFont(new Font("Arial", Font.BOLD, 22));
                надписьКорабль.setForeground(Color.YELLOW);
                надписьКорабль.setBounds(20, 85, 650, 40);
                панель.add(надписьКорабль);

                надписьТопливо = new JLabel("");
                надписьТопливо.setFont(new Font("Arial", Font.BOLD, 22));
                надписьТопливо.setForeground(Color.WHITE);
                надписьТопливо.setBounds(200, 100, 600, 40);
                панель.add(надписьТопливо);
            }

            //кнопки
            static void createButtons() {
                кнопкаНоваяИгра = mkText("Новая игра", 350, 300, 300, 70);
                панель.add(кнопкаНоваяИгра);
                кнопкаНастройки = mkText("Настройки", 400, 390, 200, 60);
                панель.add(кнопкаНастройки);

                кнопкаГенераторная = mkText("Генераторная", 30, 430, 210, 55);
                панель.add(кнопкаГенераторная);
                кнопкаДверь = mkText("Дверь", 260, 430, 150, 55);
                панель.add(кнопкаДверь);
                кнопкаФонарь = mkText("Фонарь", 430, 430, 150, 55);
                панель.add(кнопкаФонарь);
                кнопкаСклад = mkText("Склад", 600, 430, 150, 55);
                панель.add(кнопкаСклад);
                кнопкаКарта = mkText("Карта", 780, 430, 170, 55);
                панель.add(кнопкаКарта);
                кнопкаНазад = mkText("Назад", 20, 520, 130, 45);
                панель.add(кнопкаНазад);

                кнопкаЗаправить = mkText("Заправить", 350, 400, 250, 65);
                панель.add(кнопкаЗаправить);
                кнопкаЗапустить = mkText("Запустить генератор", 330, 400, 340, 65);
                панель.add(кнопкаЗапустить);
                кнопкаВосстановить = mkText("Восстановить свет", 350, 400, 300, 65);
                панель.add(кнопкаВосстановить);
                кнопкаСопроводить = mkText("Сопроводить корабль", 330, 400, 340, 65);
                панель.add(кнопкаСопроводить);

                панель.setComponentZOrder(фон, панель.getComponentCount() - 1);
            }

            //таймеры
            static void createTimers() {
                таймерКорабля = new Timer(10000, new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        gameOver();
                    }
                });

                главныйТаймер = new Timer(3000, new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        заряд--;
                        надписьЗаряд.setText("Заряд: " + заряд + "%");

                        if (генераторРаботает && Math.random() < ШАНС_ОСТАНОВКИ_ГЕНЕРАТОРА) {
                            stopGenerator();
                        }

                        if (светВключён && Math.random() < ШАНС_ОТКЛЮЧЕНИЯ_СВЕТА) {
                            turnOffLight();
                        }

                        if (!корабльЖдёт && Math.random() < ШАНС_ПРИБЫТИЯ_КОРАБЛЯ) {
                            shipArrives();
                        }

                        if (заряд <= 0) {
                            gameOver();
                        }
                    }
                });
            }

            //обработчики нажатий
            static void addListeners() {
                кнопкаНоваяИгра.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        startGame();
                    }
                });

                кнопкаНастройки.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        openSettings();
                    }
                });

                кнопкаГенераторная.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        openGenerator();
                    }
                });

                кнопкаДверь.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        room("дверь", КАРТИНКА_ДВЕРЬ);
                    }
                });

                кнопкаФонарь.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        openLantern();
                    }
                });

                кнопкаСклад.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        room("склад", КАРТИНКА_СКЛАД);
                    }
                });

                кнопкаКарта.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        openMap();
                    }
                });

                кнопкаНазад.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        if (текущаяКомната.equals("настройки")) {
                            menu();
                        } else {
                            showLighthouse();
                        }
                    }
                });

                кнопкаЗаправить.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        топливо = 100;
                        updateGeneratorLabel();
                        кнопкаЗаправить.setVisible(false);
                        кнопкаЗапустить.setVisible(true);
                    }
                });

                кнопкаЗапустить.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        генераторРаботает = true;
                        updateGeneratorLabel();
                        надписьФонарь.setText("Фонарь: выключен");
                        кнопкаЗапустить.setVisible(false);
                    }
                });

                кнопкаВосстановить.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        светВключён = true;
                        надписьФонарь.setText("Фонарь: работает");
                        фон.setIcon(sbg(КАРТИНКА_ФОНАРЬ_ВКЛ));
                        кнопкаВосстановить.setVisible(false);
                    }
                });

                кнопкаСопроводить.addActionListener(new ActionListener() {
                    public void actionPerformed(ActionEvent событие) {
                        корабльЖдёт = false;
                        таймерКорабля.stop();
                        надписьКорабль.setText("");
                        кнопкаСопроводить.setVisible(false);
                    }
                });

                фон.addMouseListener(new MouseAdapter() {
                    public void mouseClicked(MouseEvent событие) {
                        if (играОкончена) {
                            menu();
                        }
                    }
                });
            }

            //события игры
            static void shipArrives() {
                корабльЖдёт = true;
                надписьКорабль.setText("ПРИБЫЛ КОРАБЛЬ! Сопроводите его!");
                if (текущаяКомната.equals("карта")) {
                    updateEscortButton();
                }
                таймерКорабля.start();
            }

            static void updateEscortButton() {
                кнопкаСопроводить.setVisible(корабльЖдёт);
                кнопкаСопроводить.setEnabled(светВключён);
                if (светВключён) {
                    кнопкаСопроводить.setText("Сопроводить корабль");
                } else {
                    кнопкаСопроводить.setText("Сначала включите свет!");
                }
            }

            static void turnOffLight() {
                светВключён = false;
                надписьФонарь.setText("Фонарь: СВЕТ ОТКЛЮЧЁН");
                if (текущаяКомната.equals("фонарь")) {
                    фон.setIcon(sbg(КАРТИНКА_ФОНАРЬ_ВЫКЛ));
                    кнопкаВосстановить.setVisible(генераторРаботает);
                }
                if (текущаяКомната.equals("карта")) {
                    updateEscortButton();
                }
            }

            static void stopGenerator() {
                генераторРаботает = false;
                if (светВключён) {
                    turnOffLight();
                }
                надписьФонарь.setText("Фонарь: нет питания, генератор остановлен");
                кнопкаВосстановить.setVisible(false);
                if (текущаяКомната.equals("генераторная")) {
                    updateGeneratorLabel();
                    кнопкаЗапустить.setVisible(true);
                }
            }

            static void updateGeneratorLabel() {
                String состояние;
                if (генераторРаботает) {
                    состояние = "работает";
                } else {
                    состояние = "остановлен";
                }
                надписьТопливо.setText("Топливо: " + топливо + "%   Генератор: " + состояние);
            }

            //экраны
            static void menu() {
                играОкончена = false;
                текущаяКомната = "меню";

                фон.setText("");
                фон.setOpaque(false);
                фон.setIcon(sbg(КАРТИНКА_МАЯК));

                hideAll();
                кнопкаНоваяИгра.setVisible(true);
                кнопкаНастройки.setVisible(true);
            }

            static void startGame() {
                заряд = 100;
                топливо = 0;
                генераторРаботает = false;
                светВключён = false;
                корабльЖдёт = false;

                надписьЗаряд.setText("Заряд: 100%");
                надписьФонарь.setText("Фонарь: выключен");
                надписьКорабль.setText("");

                надписьЗаряд.setVisible(true);
                надписьФонарь.setVisible(true);
                надписьКорабль.setVisible(true);
                кнопкаНоваяИгра.setVisible(false);
                кнопкаНастройки.setVisible(false);

                showLighthouse();
                главныйТаймер.start();
            }

            static void openSettings() {
                текущаяКомната = "настройки";
                фон.setIcon(sbg(КАРТИНКА_НАСТРОЙКИ));
                hideAll();
                кнопкаНазад.setVisible(true);
            }

            static void showLighthouse() {
                текущаяКомната = "дом";
                фон.setIcon(sbg(КАРТИНКА_МАЯК));

                hideRooms();
                кнопкаНазад.setVisible(false);
                кнопкаГенераторная.setVisible(true);
                кнопкаДверь.setVisible(true);
                кнопкаФонарь.setVisible(true);
                кнопкаСклад.setVisible(true);
                кнопкаКарта.setVisible(true);
            }

            static void openGenerator() {
                текущаяКомната = "генераторная";
                фон.setIcon(sbg(КАРТИНКА_ГЕНЕРАТОРНАЯ));
                hideRooms();
                кнопкаНазад.setVisible(true);

                updateGeneratorLabel();
                надписьТопливо.setVisible(true);
                кнопкаЗаправить.setVisible(топливо < 100);
                кнопкаЗапустить.setVisible(топливо > 0 && !генераторРаботает);
            }

            static void openLantern() {
                текущаяКомната = "фонарь";
                hideRooms();
                кнопкаНазад.setVisible(true);

                if (светВключён) {
                    фон.setIcon(sbg(КАРТИНКА_ФОНАРЬ_ВКЛ));
                } else {
                    фон.setIcon(sbg(КАРТИНКА_ФОНАРЬ_ВЫКЛ));
                }

                кнопкаВосстановить.setVisible(!светВключён && генераторРаботает);
            }

            static void openMap() {
                текущаяКомната = "карта";
                фон.setIcon(sbg(КАРТИНКА_КАРТА));
                hideRooms();
                кнопкаНазад.setVisible(true);
                updateEscortButton();
            }

            static void room(String названиеКомнаты, String путь) {
                текущаяКомната = названиеКомнаты;
                фон.setIcon(sbg(путь));
                hideRooms();
                кнопкаНазад.setVisible(true);
            }

            static void gameOver() {
                играОкончена = true;
                главныйТаймер.stop();
                таймерКорабля.stop();

                hideAll();

                фон.setIcon(null);
                фон.setOpaque(true);
                фон.setBackground(Color.BLACK);
                фон.setHorizontalAlignment(SwingConstants.CENTER);
                фон.setForeground(Color.WHITE);
                фон.setFont(new Font("Arial", Font.BOLD, 30));
                фон.setText("<html><div style='text-align:center;'>ИГРА ОКОНЧЕНА<br><br><font size='5'>Нажмите на экран, чтобы вернуться в меню</font></div></html>");
            }

            //скрытие интерфейса
            static void hideRooms() {
                кнопкаГенераторная.setVisible(false);
                кнопкаДверь.setVisible(false);
                кнопкаФонарь.setVisible(false);
                кнопкаСклад.setVisible(false);
                кнопкаКарта.setVisible(false);

                кнопкаЗаправить.setVisible(false);
                кнопкаЗапустить.setVisible(false);
                кнопкаВосстановить.setVisible(false);
                кнопкаСопроводить.setVisible(false);
                надписьТопливо.setVisible(false);
            }

            static void hideAll() {
                надписьЗаряд.setVisible(false);
                надписьФонарь.setVisible(false);
                надписьКорабль.setVisible(false);
                hideRooms();
                кнопкаНазад.setVisible(false);
                кнопкаНоваяИгра.setVisible(false);
                кнопкаНастройки.setVisible(false);
            }

            //загрузка картинок
            static ImageIcon sbg(String путь) {
                ImageIcon исходная = new ImageIcon(путь);
                Image картинка = исходная.getImage();
                Image растянутая = картинка.getScaledInstance(1000, 600, Image.SCALE_SMOOTH);
                return new ImageIcon(растянутая);
            }

            //создание кнопки
            static JButton mkText(String текст, int x, int y, int ширина, int высота) {
                JButton кнопка = new JButton(текст);
                кнопка.setFont(new Font("Arial", Font.BOLD, 20));
                кнопка.setBounds(x, y, ширина, высота);
                кнопка.setBackground(new Color(35, 35, 35));
                кнопка.setForeground(Color.WHITE);
                кнопка.setFocusPainted(false);
                кнопка.setOpaque(true);
                return кнопка;
            }
        }
