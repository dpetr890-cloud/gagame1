        изображение_комнаты.setIcon(sbg(путь_карты));//изображение
        изображение_комнаты.setText("");

        hideRooms();

        кнопка_назад.setVisible(true);

        updateEscortButton();

        панель_игры.repaint();
    }


    //по такому же принципу 2 оставшиеся комнаты без механик какких то
    static void room(String путь_к_изображению) {

        if (путь_к_изображению.equals(путь_фона_двери)) {
            текущая_комната = "door";
        } else if (путь_к_изображению.equals(путь_фона_склада)) {
            текущая_комната = "storage";
        }

        изображение_комнаты.setIcon(sbg(путь_к_изображению));
        изображение_комнаты.setText("");

        hideRooms();

        кнопка_назад.setVisible(true);

        панель_игры.repaint();
    }


